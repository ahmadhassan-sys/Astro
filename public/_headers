# Netlify caching rules (other hosts ignore this file).
# Files in /_astro have a content hash in their name, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images, videos and scripts keep their names when edited: cache them for a day, then check for a newer copy
# (the visitor gets the cached copy instantly while the check runs in the background).
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
