---
/**
 * Work page · 1. Hero — header, intro, the spinning fan of case-study pages, the title and the scroll hint.
 * The pages in the fan are built by the script from `cases`.
 * Content: `hero` in src/data/work.js (+ `nav` from src/data/site.js)
 * Scripts: public/js/work-page.js, work-hero.js, header.js, hero-light.js
 * Styles: src/styles/work-page/hero.css
 */
import Header from "../Header.astro";

const { nav, glow, intro, rigLabel, title, scrollHint } = Astro.props;
---
<section class="b30h wk-hero" aria-labelledby="wk-title">
  <div class="b30h__pin">
    <div class="b30h__stage">
      <span class="b30h__vline b30h__vline--34" aria-hidden="true"></span>
      <i class="b30h__px" style="--x:82" aria-hidden="true"></i>
      <i class="b30h__px" style="--x:960" aria-hidden="true"></i>
      <i class="b30h__px" style="--x:1838" aria-hidden="true"></i>
      <span class="b30h__vline b30h__vline--27" aria-hidden="true"></span>
      <img class="b30h__glow" src={glow} alt="" aria-hidden="true" decoding="async" />

      <Header {...nav} page="work" />

      <p class="wk-hero__intro" data-reveal style="--rd:200ms">{intro}</p>

      <div class="wk-rig" data-cur="Drag" role="group" aria-label={rigLabel}>
        <div class="wk-rig__spin"></div>
      </div>
      <p class="wk-hero__name" aria-live="polite"></p>
      <h1 class="wk-hero__title" id="wk-title" data-heading>{title.map((line, i) => [i > 0 ? " " : null, <span>{line}</span>])}</h1>
      <p class="wk-hero__scroll">{scrollHint}</p>

      <span class="b30h__vline b30h__vline--26" aria-hidden="true"></span>
    </div>
    <div class="wk-hero__dim" aria-hidden="true"></div>
  </div>
</section>
