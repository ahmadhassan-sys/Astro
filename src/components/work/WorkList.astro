---
/**
 * Work page · 2. The list — filter tabs + grid/index switch, the featured project,
 * the "Selected work" heading, and every case study as a grid card and an index row.
 * Content: `filters`, `featured`, `selected`, `cases` in src/data/work.js · Script: public/js/work-page.js
 * Styles: src/styles/work-page/list.css
 */
import Rich from "../ui/Rich.astro";
import ArrowIcon from "../ui/ArrowIcon.astro";
import RowArrow from "./RowArrow.astro";
import { imageKey } from "./image-key.js";

const { filters, featured, selected, cases } = Astro.props;

const pad = (n) => String(n).padStart(2, "0");
const tagLabel = Object.fromEntries(filters.items.map((f) => [f.key, f.tag]));
const count = (key) => pad(key === "all" ? cases.length : cases.filter((c) => c.tags.includes(key)).length);
const tabs = [{ key: "all", tab: filters.allLabel }, ...filters.items];
const featuredCase = cases.find((c) => c.id === featured.moreFrom);
const caseLink = { "data-pt": "", "data-pt-label": "Case study" };   // page transition into the case study
---
<div class="wk-list" id="work">
  <div class="wk-fbar"><div class="wk-fbar__in">
    <ul class="wk-tabs" aria-label={filters.label}>
      {tabs.map((t, i) => (
        <li><button type="button" class="wk-tab" data-f={t.key} aria-pressed={i === 0 ? "true" : "false"}>{`${t.tab} `}<sup>{count(t.key)}</sup></button></li>
      ))}
    </ul>
    <div class="wk-views" role="group" aria-label={filters.views.label}>
      <button type="button" class="wk-view" data-view="grid" aria-pressed="true"><svg class="wk-view__ic" viewBox="0 0 12 12" aria-hidden="true"><rect x="0" y="0" width="5" height="5" /><rect x="7" y="0" width="5" height="5" /><rect x="0" y="7" width="5" height="5" /><rect x="7" y="7" width="5" height="5" /></svg>{filters.views.grid}</button>
      <i aria-hidden="true"></i>
      <button type="button" class="wk-view" data-view="index" aria-pressed="false"><svg class="wk-view__ic" viewBox="0 0 12 12" aria-hidden="true"><rect x="0" y="1" width="12" height="4" /><rect x="0" y="7" width="12" height="4" /></svg>{filters.views.index}</button>
    </div>
  </div></div>

  <section class="wk-feat" aria-labelledby="wk-feat-t">
    <p class="wk-feat__k" data-reveal data-pair>{featured.kicker}</p>
    <div class="wk-feat__row">
      <div>
        <h2 class="wk-feat__t" id="wk-feat-t" data-heading>{featured.title}</h2>
        <p class="wk-feat__meta" data-reveal data-pair style="--rd:240ms">{featured.meta}</p>
      </div>
      <div>
        <p class="wk-feat__name" data-reveal data-pair style="--rd:160ms">{featured.name}</p>
        <p class="wk-feat__p" data-reveal data-pair style="--rd:260ms">{featured.text}</p>
        <a class="b30btn b30btn--line wk-vcs" href={featured.href} data-btn {...caseLink} data-reveal data-pair style="--rd:360ms"><span class="b30btn__ic"><ArrowIcon /><ArrowIcon /></span><span class="b30btn__lbl" data-lbl>{featured.cta}</span></a>
      </div>
      <span class="wk-feat__yr" data-reveal data-pair style="--rd:200ms">{featured.year}</span>
    </div>
    <a class="wk-media" href={featured.href} {...caseLink} aria-label={featured.mediaLabel}><span class="wk-media__in"><img data-src="featured" alt="" class="is-on" decoding="async" />{featuredCase ? featuredCase.images.slice(1).map((_, i) => <img data-src={imageKey(featuredCase.id, i + 1)} alt="" decoding="async" />) : null}</span></a>
  </section>

  <section class="wk-sel" aria-labelledby="wk-sel-t">
    <p data-reveal data-pair data-speed="0.97">{selected.intro}</p>
    <h2 id="wk-sel-t" data-heading data-speed="1.04"><Rich text={selected.heading} /></h2>
  </section>

  <div class="wk-views-box" data-view="grid">
    <div class="wk-grid">
      {cases.map((c, n) => (
        <article class="wk-card" data-tags={c.tags.join(" ")}>
          <p class="wk-card__n">{pad(n + 1)}</p>
          <a class="wk-media" href={c.href} {...caseLink} aria-label={`${c.name} case study`}><span class="wk-media__in">{c.images.map((_, i) => <img data-src={imageKey(c.id, i)} alt="" class={i === 0 ? "is-on" : undefined} decoding="async" />)}</span></a>
          <div class="wk-card__b">
            <h3 class="wk-card__t" data-heading><a href={c.href} {...caseLink}>{c.name}</a></h3>
            <div class="wk-card__r"><p data-reveal style="--rd:180ms">{c.summary}</p><div data-reveal style="--rd:300ms"><ul class="wk-tags">{c.tags.map((t) => <li>{tagLabel[t] || t}</li>)}</ul></div></div>
          </div>
        </article>
      ))}
    </div>
    <ol class="wk-index">
      {cases.map((c, n) => (
        <li class="wk-row" data-tags={c.tags.join(" ")}>
          <a href={c.href} {...caseLink}>
            <span class="wk-row__n">{pad(n + 1)}</span>
            <h3 class="wk-row__t">{c.name}</h3>
            <p class="wk-row__d">{c.short}</p>
            <ul class="wk-tags">{c.tags.map((t) => <li>{tagLabel[t] || t}</li>)}</ul>
            <span class="wk-row__ar" aria-hidden="true"><RowArrow /><RowArrow /></span>
            <span class="wk-row__imgs" aria-hidden="true">{c.images.slice(0, 4).map((_, i) => <span><img data-src={imageKey(c.id, i)} alt="" style={`--k:${i}`} decoding="async" /></span>)}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</div>
