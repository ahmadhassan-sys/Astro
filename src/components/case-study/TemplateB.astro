---
/**
 * Case study · template B (Construction Check, The Coupon Chaser, Weldon Brewster, Ethical Narrative).
 * The page is the file's `sections`, in order. Section types: intro, demo, overview, rule, services, challenge,
 * beforeAfter, stat, how, note, output, statement, brand, impact, outcome, next (each one: b/Section.astro).
 * Numbered sections (overview, services, challenge, how, output, brand, impact, outcome) count up (01)…(07) by
 * themselves. The shared closing parts come in through the slot, inside <main>.
 * Content: src/content/case-studies/<name>.yaml · Styles: src/styles/case-study-b/ · Scripts: public/js/case-study-b/
 */
import CaseTop from "./sections/CaseTop.astro";
import CaseHero from "./sections/CaseHero.astro";
import Section from "./b/Section.astro";

const { data, next, nav, labels } = Astro.props;
const NUMBERED = new Set(["overview", "services", "challenge", "how", "output", "brand", "impact", "outcome"]);
let k = 0;
const items = data.sections.map((s) => ({ s, n: NUMBERED.has(s.type) ? `(${String(++k).padStart(2, "0")})` : null }));
---
<CaseTop nav={nav} />
<CaseHero {...data.hero} />

<main class="b30-main" id="main">
  {items.map(({ s, n }) => <Section s={s} n={n} name={data.name} labels={labels} next={next} />)}
  <slot />
</main>
