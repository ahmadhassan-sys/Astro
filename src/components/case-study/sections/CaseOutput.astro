---
/** (05) The output: sticky tabs and one block per part (public/js/case-study/output.js). */
import Label from "../parts/Label.astro";
import Picture from "../parts/Picture.astro";
import Rich from "../../ui/Rich.astro";
const { n, labels, heading, navLabel, parts } = Astro.props;
const pad = (i) => String(i + 1).padStart(2, "0");
---
<section class="cz-out" aria-labelledby="cz-out-h">
  <div class="cz-how__head cz-out__head">
    <Label n={n} title={labels.output} />
    <h2 class="cz-h71" id="cz-out-h" data-heading><Rich text={heading} /></h2>
  </div>
  <nav class="cz-tabs" aria-label={navLabel}>{parts.map((p, i) => (
    <a class="cz-tab" href={`#part-${i + 1}`} data-i={i}><i class="cz-tab__bar" aria-hidden="true"></i><span>{pad(i)}.&nbsp; {p.tab}</span></a>
  ))}</nav>
  <div class="cz-parts">{parts.map((p, i) => (
    <article class="cz-part" id={`part-${i + 1}`}><p class="cz-part__k">{labels.part} {i + 1}</p><div class="cz-part__row"><h3 class="cz-h36" data-heading>{p.title}</h3><p class="cz-body" data-reveal>{p.text}</p></div><Picture class="cz-part__img" image={p.image} alt={p.alt} /></article>
  ))}</div>
</section>
