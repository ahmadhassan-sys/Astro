---
/**
 * Pixel icon by name: "phone" | "target" | "target24".
 * The paths are in ./icon-data.js.
 */
import { PHONE, TARGET, TARGET_24 } from "./icon-data.js";

interface Props { name?: string }
const { name = "target" } = Astro.props;
---
{name === "phone" ? (
  <svg viewBox="0 0 22 22" fill="#000" aria-hidden="true">{PHONE.map((d) => <path d={d} />)}</svg>
) : name === "target24" ? (
  <svg viewBox="0 0 24.0011 24" fill="#000" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">{TARGET_24.map((d) => <path d={d} />)}</svg>
) : (
  <svg viewBox="0 0 22 22" fill="#000" aria-hidden="true">{TARGET.map((d) => <path d={d} />)}</svg>
)}
