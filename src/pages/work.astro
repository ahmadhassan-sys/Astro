---
/**
 * Our Work page — /work
 * Its own sections: components/work/*  ·  content: src/data/work.js
 * Shared with the other pages: header, partners strip, testimonials, closing line, footer
 * (components/*, content: src/data/site.js).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/work.css";   // all Our Work page styles, in order

import WorkHero from "../components/work/WorkHero.astro";
import PartnersStrip from "../components/PartnersStrip.astro";
import WorkList from "../components/work/WorkList.astro";
import { imageKey } from "../components/work/image-key.js";
import WorkHello from "../components/work/WorkHello.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

import { seo, hero, filters, cases, featured, selected, hello } from "../data/work.js";
import { nav, partnersStrip, testimonials, contact, footer } from "../data/site.js";

/* What the page scripts (public/js) read: every picture by key, and the case studies for the hero's fan. */
const tagLabel = Object.fromEntries(filters.items.map((f) => [f.key, f.tag]));
const images = { featured: featured.cover };
cases.forEach((c) => c.images.forEach((src, i) => { images[imageKey(c.id, i)] = src; }));
const scriptContent = {
  workPage: {
    images,
    cases: cases.map((c) => ({ id: c.id, name: c.name, href: c.href, imgs: c.images.map((_, i) => imageKey(c.id, i)), tl: c.tags.map((t) => tagLabel[t] || t) })),
  },
  testimonials: { items: testimonials.items },
  contact: { heading: contact.heading, closing: contact.closing },
};

/* Page scripts, in the order they run. */
const scripts = [
  "core",            // scale, smooth scroll, headings, reveals (must be first)
  "header",          // logo hover, header pixels
  "hero-light",      // the hero's glow
  "work-page",       // the fan of pages, filters, grid/index, picture hovers, the hand
  "partners",
  "testimonials",
  "contact",
  "footer",
  "theme",           // day / night switch and the dark theme
  "details",         // small finishing touches across sections
  "work-hero",       // the hero's drift as the page scrolls over it
  "contact-closing", // the closing words (must run last: it sits on top of the contact panel)
];
---

<BaseLayout seo={seo} content={scriptContent} scripts={scripts}>
  <WorkHero {...hero} nav={nav} />

  <main class="b30-main" id="main">
    <PartnersStrip {...partnersStrip} />
    <WorkList filters={filters} featured={featured} selected={selected} cases={cases} />
    <WorkHello {...hello} />
    <Testimonials {...testimonials} />
    <Contact {...contact} />
  </main>

  <Footer {...footer} page="work" />
</BaseLayout>
